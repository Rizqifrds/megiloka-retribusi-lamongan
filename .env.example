# Kosongkan untuk membuat kunci lokal otomatis di backend/instance/.
SECRET_KEY=

# System Database Configuration (mysql / sqlite)
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=megiloka_db

# Integrasi opsional pengelola wisata. Isi token acak khusus webhook.
HOLIDAY_PARTNER_URL=
HOLIDAY_WEBHOOK_TOKEN=

# Meta Business Discovery untuk Instagram WBL.
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Informasi rekening dan QRIS resmi yang ditampilkan di POS.
# PAYMENT_QRIS_IMAGE diisi nama berkas dalam frontend/images.
PAYMENT_QRIS_IMAGE=
PAYMENT_BANK_DETAILS=

# Integrasi WhatsApp opsional.
WHATSAPP_NUMBER=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AGENDA_TEMPLATE=
